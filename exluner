                { id: 1, folder: "หน้าแรก (Home)", type: "text-rect", size: "md", title: "About Me", content: "ยินดีต้อนรับสู่พื้นที่รวมผลงานครับ" },
                { id: 2, folder: "ผลงาน (Works)", type: "image", imgUrl: "https://picsum.photos/500/300", imgDesc: "ตัวอย่างผลงานกราฟิกสไตล์มินิมอล" },
                { id: 3, folder: "ติดต่อ (Contact)", type: "contact-1col", contactName: "Instagram", contactLink: "https://instagram.com", contactIcon: "fab fa-instagram" }
            ]
        };

        let appData = defaultData;
        let activeFolder = "หน้าแรก (Home)";
        let currentRole = null; 
        let editingBlockId = null; 
        let selectedBlockType = null;

        // Crop Instance Variables
        let cropper = null;
        let targetFieldForCrop = null;

        function fetchCloudData() {
            db.collection("sites").doc("main_site").get().then((doc) => {
                if (doc.exists) { appData = doc.data(); } else { saveData(); }
                if (appData.folders && appData.folders.length > 0) { activeFolder = appData.folders[0]; }
                initApp();
            }).catch((error) => { console.error("Firebase fetch error:", error); initApp(); });
        }

        function initApp() {
            document.title = appData.name || "My Custom Profile";
            document.documentElement.setAttribute('data-theme', appData.themeMode || 'dark');
            document.documentElement.style.setProperty('--primary-color', appData.themeColor || '#ff5e97');
            document.getElementById('footer-credit').innerHTML = appData.developerCredit || '';

            const themeBtn = document.getElementById('theme-btn');
            themeBtn.innerHTML = appData.themeMode === 'light' ? `<i class="fas fa-moon"></i> โหมดมืด` : `<i class="fas fa-sun"></i> โหมดสว่าง`;

            document.getElementById('display-name').innerText = appData.name || '';
            const bioDetailEl = document.getElementById('display-bio');
            if (appData.bio && appData.bio.trim() !== "") {
                bioDetailEl.innerText = appData.bio;
                bioDetailEl.style.display = 'block';
            } else { bioDetailEl.style.display = 'none'; }

            const avatarEl = document.getElementById('display-avatar');
            if (appData.showProfile) {
                avatarEl.style.display = 'block';
                avatarEl.src = appData.avatarUrl || 'https://picsum.photos/200';
            } else { avatarEl.style.display = 'none'; }

            const bannerBox = document.getElementById('banner-box');
            if (!appData.bannerUrl) { bannerBox.innerHTML = ''; }
            else if (appData.bannerUrl.includes('video') || appData.bannerUrl.endsWith('.mp4')) {
                bannerBox.innerHTML = `<video class="banner-media" autoplay loop muted playsinline src="${appData.bannerUrl}"></video>`;
            } else {
                bannerBox.innerHTML = `<img class="banner-media" src="${appData.bannerUrl}" alt="Banner">`;
            }

            document.getElementById('song-title-txt').innerText = appData.songTitle || 'ไม่พบเพลง';
            document.getElementById('cd-cover').style.backgroundImage = `url('${appData.songCover || 'https://picsum.photos/100'}')`;
            
            const audio = document.getElementById('bg-audio');
            if (appData.songUrl && audio.src !== appData.songUrl) { audio.src = appData.songUrl; }

            renderFolders();
            renderBlocks();
        }

        function toggleTheme() {
            appData.themeMode = appData.themeMode === 'light' ? 'dark' : 'light';
            saveData();
        }

        function renderFolders() {
            const bar = document.getElementById('folder-bar');
            if (!appData.folders) appData.folders = [];
            bar.innerHTML = appData.folders.map(f => `
                <div class="folder-tab ${f === activeFolder ? 'active' : ''}" onclick="selectFolder('${f}')">
                    <i class="fas fa-folder"></i> ${f}
                </div>
            `).join('');
        }

        function selectFolder(f) {
            activeFolder = f;
            renderFolders();
            renderBlocks();
        }

        function renderBlocks() {
            const container = document.getElementById('content-container');
            const blocks = appData.blocks || [];
            const filtered = blocks.filter(b => b.folder === activeFolder);

            if (filtered.length === 0) {
                container.innerHTML = `<div style="text-align:center; padding:40px; color:var(--text-muted);">ไม่มีเนื้อหาในโฟลเดอร์นี้ กดปุ่ม "+ เพิ่มบล็อก" ด้านบนเพื่อเพิ่มได้เลย!</div>`;
                return;
            }

            let html = `<div class="blocks-grid">`;
            filtered.forEach(b => {
                const isMediaVideo = b.imgUrl && (b.imgUrl.includes('data:video') || b.imgUrl.endsWith('.mp4'));
                const actionBtns = currentRole ? `
                    <div class="block-actions">
                        <button class="block-act-btn" onclick="openBlockForm('${b.type}', ${b.id})">✏️ แก้ไข</button>
                        <button class="block-act-btn del" onclick="deleteBlockDirect(${b.id})">🗑️ ลบ</button>
                    </div>
                ` : '';

                html += `<div class="block-wrapper">`;
                if (b.type.startsWith('text')) {
                    const sizeClass = `block-size-${b.size || 'sm'}`;
                    html += `
                        <div class="block-card ${sizeClass}">
                            ${actionBtns}
                            ${b.title ? `<h3 style="color:var(--primary-color); margin-bottom:5px;">${b.title}</h3>` : ''}
                            <div>${b.content || ''}</div>
                        </div>`;
                } else if (b.type === 'image' || b.type === 'product') {
                    html += `
                        <div class="img-block-card block-size-sm">
                            ${actionBtns}
                            ${isMediaVideo ? `<video src="${b.imgUrl}" autoplay loop muted playsinline></video>` : `<img src="${b.imgUrl}" alt="Media">`}
                            <div class="img-block-body">
                                <strong>${b.title || ''}</strong>
                                ${b.price ? `<div style="color:var(--primary-color); font-weight:600;">${b.price}</div>` : ''}
                                ${b.imgDesc ? `<div style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">${b.imgDesc}</div>` : ''}
                            </div>
                        </div>`;
                } else if (b.type.startsWith('contact')) {
                    html += `
                        <div style="position:relative;">
                            ${actionBtns}
                            <a href="${b.contactLink || '#'}" target="_blank" class="contact-btn block-size-sm">
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <i class="${b.contactIcon || 'fas fa-link'}" style="font-size:1.3rem; color:var(--primary-color);"></i>
                                    <span style="font-weight:500;">${b.contactName}</span>
                                </div>
                                <i class="fas fa-chevron-right" style="font-size:0.8rem; opacity:0.5;"></i>
                            </a>
                        </div>`;
                }
                html += `</div>`;
            });
            html += `</div>`;
            container.innerHTML = html;
        }

        function deleteBlockDirect(id) {
            if (confirm("คุณต้องการลบบล็อกนี้ใช่ไหม?")) {
                appData.blocks = appData.blocks.filter(b => b.id !== id);
                saveData();
            }
        }

        // Image Cropper Logic
        function handleFileCrop(input, targetFieldId, aspectRatio) {
            const file = input.files[0];
            if (!file) return;

            // If video file, skip cropper
            if (file.type.startsWith('video/')) {
                const reader = new FileReader();
                reader.onload = function(e) { document.getElementById(targetFieldId).value = e.target.result; };
                reader.readAsDataURL(file);
                return;
            }

            targetFieldForCrop = targetFieldId;
            const reader = new FileReader();
            reader.onload = function(e) {
                const cropImg = document.getElementById('crop-image-element');
                cropImg.src = e.target.result;

                document.getElementById('crop-modal').style.display = 'flex';

                if (cropper) { cropper.destroy(); }
                cropper = new Cropper(cropImg, {
                    aspectRatio: aspectRatio,
                    viewMode: 1,
                    autoCropArea: 1,
                });
            };
            reader.readAsDataURL(file);
        }

        function applyCrop() {
            if (!cropper) return;
            const canvas = cropper.getCroppedCanvas({
                maxWidth: 1200,
                maxHeight: 1200,
            });
            
            const croppedDataUrl = canvas.toDataURL('image/jpeg', 0.85);
            document.getElementById(targetFieldForCrop).value = croppedDataUrl;
            
            closeModal('crop-modal');
            if (cropper) { cropper.destroy(); cropper = null; }
        }

        function handleFileUpload(input, targetFieldId) {
            const file = input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) { document.getElementById(targetFieldId).value = e.target.result; };
            reader.readAsDataURL(file);
        }

        function openBlockForm(type, blockId = null) {
            selectedBlockType = type;
            editingBlockId = blockId;
            closeModal('openlink-menu-modal');

            const existingBlock = blockId ? appData.blocks.find(b => b.id === blockId) : null;
            const fieldsContainer = document.getElementById('dynamic-form-fields');
            let html = '';

            document.getElementById('form-block-title').innerText = blockId ? "✏️ แก้ไขบล็อก" : "➕ เพิ่มบล็อกใหม่";

            if (type.startsWith('contact')) {
                html = `
                    <div class="form-group"><label>ชื่อปุ่ม / ช่องทาง</label><input type="text" id="bf-name" class="form-control" value="${existingBlock ? existingBlock.contactName || '' : ''}"></div>
                    <div class="form-group"><label>URL ลิงก์</label><input type="text" id="bf-link" class="form-control" value="${existingBlock ? existingBlock.contactLink || '' : ''}"></div>
                    <div class="form-group"><label>ไอคอน FontAwesome</label><input type="text" id="bf-icon" class="form-control" value="${existingBlock ? existingBlock.contactIcon || '' : 'fas fa-link'}"></div>
                `;
            } else if (type === 'product' || type === 'image') {
                html = `
                    <div class="form-group">
                        <label>รูปภาพ / GIF / วิดีโอ (เลือกจากอัลบั้ม หรือ วาง URL)</label>
                        <div class="file-input-wrapper">
                            <input type="text" id="bf-img" class="form-control" value="${existingBlock ? existingBlock.imgUrl || '' : ''}">
                            <label class="upload-btn-label">📁 เลือกรูป <input type="file" accept="image/*,video/*" style="display:none;" onchange="handleFileUpload(this, 'bf-img')"></label>
                        </div>
                    </div>
                    <div class="form-group"><label>ชื่อหัวข้อ / ชื่อสินค้า</label><input type="text" id="bf-title" class="form-control" value="${existingBlock ? existingBlock.title || '' : ''}"></div>
                    ${type === 'product' ? `<div class="form-group"><label>ราคาสินค้า</label><input type="text" id="bf-price" class="form-control" value="${existingBlock ? existingBlock.price || '' : ''}"></div>` : ''}
                    <div class="form-group"><label>รายละเอียดเพิ่มเติม</label><input type="text" id="bf-desc" class="form-control" value="${existingBlock ? existingBlock.imgDesc || '' : ''}"></div>
                `;
            } else if (type.startsWith('text')) {
                html = `
                    <div class="form-group"><label>ขนาดบล็อก</label>
                        <select id="bf-size" class="form-control">
                            <option value="sm" ${existingBlock && existingBlock.size==='sm'?'selected':''}>เล็ก (1 คอลัมน์)</option>
                            <option value="md" ${existingBlock && existingBlock.size==='md'?'selected':''}>กลาง (2 คอลัมน์)</option>
                            <option value="lg" ${existingBlock && existingBlock.size==='lg'?'selected':''}>ใหญ่ (3 คอลัมน์)</option>
                        </select>
                    </div>
                    <div class="form-group"><label>หัวข้อ</label><input type="text" id="bf-title" class="form-control" value="${existingBlock ? existingBlock.title || '' : ''}"></div>
                    <div class="form-group"><label>ข้อความบรรยาย</label><textarea id="bf-content" class="form-control" rows="3">${existingBlock ? existingBlock.content || '' : ''}</textarea></div>
                `;
            }

            fieldsContainer.innerHTML = html;
            document.getElementById('block-form-modal').style.display = 'flex';
        }

        function saveBlockFromForm() {
            if (!appData.blocks) appData.blocks = [];
            
            let blockData = editingBlockId ? appData.blocks.find(b => b.id === editingBlockId) : { id: Date.now(), folder: activeFolder, type: selectedBlockType };

            if (selectedBlockType.startsWith('contact')) {
                blockData.contactName = document.getElementById('bf-name').value || 'Link';
                blockData.contactLink = document.getElementById('bf-link').value || '#';
                blockData.contactIcon = document.getElementById('bf-icon').value || 'fas fa-link';
            } else if (selectedBlockType === 'product' || selectedBlockType === 'image') {
                blockData.imgUrl = document.getElementById('bf-img').value || 'https://picsum.photos/400/300';
                blockData.title = document.getElementById('bf-title').value || '';
                if (document.getElementById('bf-price')) blockData.price = document.getElementById('bf-price').value;
                blockData.imgDesc = document.getElementById('bf-desc').value || '';
            } else if (selectedBlockType.startsWith('text')) {
                blockData.size = document.getElementById('bf-size').value;
                blockData.title = document.getElementById('bf-title').value;
                blockData.content = document.getElementById('bf-content').value;
            }

            if (!editingBlockId) { appData.blocks.push(blockData); }
            saveData();
            closeModal('block-form-modal');
        }

        function checkLogin() {
            const userInput = document.getElementById('login-user').value.trim();
            const passInput = document.getElementById('login-pass').value.trim();

            if (userInput === MASTER_SUPER_USER && passInput === MASTER_SUPER_PASS) {
                currentRole = 'SUPER';
                closeModal('login-modal');
                renderBlocks();
                openDashboardModal();
            } else if ((userInput.toLowerCase() === 'client' || userInput === appData.name) && passInput === appData.clientPassword) {
                currentRole = 'CLIENT';
                closeModal('login-modal');
                renderBlocks();
                openDashboardModal();
            } else { alert('Username หรือ รหัสผ่านไม่ถูกต้อง'); }
        }

        function openDashboardModal() {
            document.getElementById('cfg-name').value = appData.name || '';
            document.getElementById('cfg-bio').value = appData.bio || '';
            document.getElementById('cfg-show-profile').value = (appData.showProfile !== undefined ? appData.showProfile : true).toString();
            document.getElementById('cfg-avatar').value = appData.avatarUrl || '';
            document.getElementById('cfg-banner').value = appData.bannerUrl || '';
            document.getElementById('cfg-color').value = appData.themeColor || '#ff5e97';
            document.getElementById('cfg-song-title').value = appData.songTitle || '';
            document.getElementById('cfg-song-cover').value = appData.songCover || '';
            document.getElementById('cfg-song-url').value = appData.songUrl || '';

            renderFolderList();

            if (currentRole === 'SUPER') {
                document.getElementById('modal-role-title').innerText = '⚙️ หลังบ้าน (Super Admin)';
                document.getElementById('super-settings').style.display = 'block';
                document.getElementById('super-client-pass').value = appData.clientPassword || '1234';
                document.getElementById('super-footer').value = appData.developerCredit || '';
            } else {
                document.getElementById('modal-role-title').innerText = '⚙️ หลังบ้าน (Client Admin)';
                document.getElementById('super-settings').style.display = 'none';
            }
            document.getElementById('admin-modal').style.display = 'flex';
        }

        function saveClientBasic() {
            appData.name = document.getElementById('cfg-name').value;
            appData.bio = document.getElementById('cfg-bio').value;
            appData.showProfile = document.getElementById('cfg-show-profile').value === 'true';
            appData.avatarUrl = document.getElementById('cfg-avatar').value;
            appData.bannerUrl = document.getElementById('cfg-banner').value;
            appData.themeColor = document.getElementById('cfg-color').value;
            appData.songTitle = document.getElementById('cfg-song-title').value;
            appData.songCover = document.getElementById('cfg-song-cover').value;
            appData.songUrl = document.getElementById('cfg-song-url').value;

            saveData();
            alert('บันทึกการตั้งค่าลง Cloud เรียบร้อย!');
        }

        function addFolder() {
            const name = document.getElementById('new-folder-name').value;
            if (!name) return;
            if (!appData.folders) appData.folders = [];
            if (!appData.folders.includes(name)) {
                appData.folders.push(name);
                saveData();
                document.getElementById('new-folder-name').value = '';
                openDashboardModal();
            }
        }

        function deleteFolder(f) {
            if (appData.folders.length <= 1) return alert('ต้องมีอย่างน้อย 1 โฟลเดอร์');
            appData.folders = appData.folders.filter(x => x !== f);
            appData.blocks = appData.blocks.filter(b => b.folder !== f);
            activeFolder = appData.folders[0];
            saveData();
            openDashboardModal();
        }

        function renderFolderList() {
            document.getElementById('folder-list').innerHTML = (appData.folders || []).map(f => `
                <div class="item-row">
                    <span>${f}</span>
                    <button class="delete-btn" onclick="deleteFolder('${f}')">ลบ</button>
                </div>
            `).join('');
        }

        function openOpenLinkMenu() {
            document.getElementById('target-folder-name').innerText = activeFolder;
            document.getElementById('openlink-menu-modal').style.display = 'flex';
        }

        function openLoginModal() { document.getElementById('login-modal').style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function toggleAudio() {
            const audio = document.getElementById('bg-audio');
            if (!audio.src) return alert('ยังไม่ได้ตั้งค่าไฟล์เพลง .mp3');
            const widget = document.getElementById('cd-widget');
            const status = document.getElementById('song-status-txt');

            if (audio.paused) {
                audio.play();
                widget.classList.add('cd-playing');
                status.innerText = 'กำลังเล่น...';
            } else {
                audio.pause();
                widget.classList.remove('cd-playing');
                status.innerText = 'คลิกเพื่อเล่น';
            }
        }

        function saveSuperSettings() {
            appData.clientPassword = document.getElementById('super-client-pass').value;
            appData.developerCredit = document.getElementById('super-footer').value;
            saveData();
            alert('บันทึกสิทธิ์ผู้พัฒนาเรียบร้อย!');
        }

        function saveData() {
            db.collection("sites").doc("main_site").set(appData).then(() => {
                initApp();
            }).catch(err => console.error("Cloud Save Error:", err));
        }

        fetchCloudData();
    </script>
</body>
</html>

